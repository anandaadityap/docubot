# Server
PORT=8080
DATABASE_PATH=/data/docubot.db
UPLOAD_DIR=/data/uploads
JWT_SECRET=change-me-please
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://chatbot.supernand.tech

# Register: first-only (default) | open | closed
# After the first admin, public /register is closed unless REGISTER_INVITE is set.
REGISTER_MODE=first-only
REGISTER_INVITE=

# Optional cost estimate for analytics (USD per 1M tokens)
TOKEN_USD_PER_MILLION=1.10

# LLM (DeepSeek - OpenAI compatible)
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=500

# Embeddings — default OpenAI, or OpenRouter (OpenAI-compatible /embeddings):
# EMBED_BASE_URL=https://openrouter.ai/api/v1
# EMBED_MODEL=nvidia/nemotron-3-embed-1b:free
EMBED_API_KEY=sk-...
EMBED_BASE_URL=https://api.openai.com/v1
EMBED_MODEL=text-embedding-3-small

# Bot defaults
BOT_TOP_K=5
BOT_MIN_SCORE=0.3
